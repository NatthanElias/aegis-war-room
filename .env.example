# Copy this file to .env (git-ignored) and fill in the values. Docker Compose reads .env automatically.

# OpenRouter API key. Without it the war room still starts and the Coordinator is offline.
OPENROUTER_API_KEY=

# One OpenRouter model ID per agent. Empty means anthropic/claude-haiku-5.5.
WARROOM_MODEL_COORDINATOR=
WARROOM_MODEL_LOGS=
WARROOM_MODEL_DB=
WARROOM_MODEL_DEPLOY=
WARROOM_MODEL_ACQUIRER=

# Shared bearer token for POST /alerts/<source>. Empty disables the alert webhooks (they answer 503).
# Generate one with: openssl rand -hex 24
WARROOM_ALERT_TOKEN=

# Optional. When set, Grafana requests must carry a valid HMAC signature (see docs/alert-webhook.md).
WARROOM_GRAFANA_HMAC_SECRET=

# New alerts accepted per sliding 60 seconds across all sources.
WARROOM_ALERT_RATE_LIMIT=30
